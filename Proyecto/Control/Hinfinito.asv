%% Parametros del modelo (Simulink)

r = 135.0e-3; % radio al motor [m]
lc = 40.67e-3; % al centro de masa [m]
I = 3.2*382.232e-7; % inercia brazo [kg*m^2]
m = 30.00e-3; % masa  brazo [kg]
g = 9.81; % gravedad [m/s^2]
ThetaLin = deg2rad(50);
%========Frición Viscosa =========== 
%B = -c.b*I/r^2;

% B = 0.0041; %Ajustado para seguir envolvente[Estático]
 B = 6*0.0041; %Ajustado para mejor respuesta dinámica

%========Torque mínimo ==============[Experimentos]
Tc = 2.7425e-05;
mu_0 = 0.7; %Frición brazo-Eje experimental (ignorar)
%==============Kuf Lineal===============

% kuf = fit_linear(1);
% kuf_0 = fit_linear(2);

kuf = 9.2568e-04;
kuf_0 = 9.2568e-04;

%==============Exponencial A*exp(b) + C*exp(d)========

% kuf_a = fit_exp.a;
% kuf_b = fit_exp.b;
% kuf_c = fit_exp.c;
% kuf_d = fit_exp.d;

kuf_a = 0.0642;
kuf_b = 0.0046; 
kuf_c = -0.0647;
kuf_d = -0.0187;

%==============Secuecia de entrada =================
repeating_sequence = [0 2 4 6 8];
step_interval = 10;   % [s] duracion de cada escalon
%%
s = tf('s');
Kuf_exp = (kuf_a)/(s+kuf_b)+(kuf_c)/(s+kuf_d)

G = kuf*(r/I)/(s^2+s*(B*r^2)/I+(lc*g*m*cos(ThetaLin))/I)
G_exp = Kuf_exp*(r/I)/(s^2+s*(B*r^2)/I+(lc*g*m*cos(ThetaLin))/I);

%bode(G)
rlocus(G)
kp = 94.008;

% Ganancia integral
rlocus(-G/(s*(-1-kp*G)))
% hold on

ki = 188.016;
CPI = (kp+ki/s);
zpk(feedback(CPI*G,1))
step(feedback(CPI*G,1))
rlocus(s*G/(1+(ki/s)*G+kp*G))
N = 100
kd = 11.751;
CPID = (kp+ki/s+N*kd/(1+N/s));
bode(CPID)
% hold on
zpk(feedback(CPID*G,1))
step(feedback(CPID*G,1));
Sys = CPID*G;
Gcl = feedback(CPID*G,1)

Ass = [0 , 1; -lc*g*m*cosd(50)/I , -B*r^2/I];
Bss = [r*kuf/I;0];
Css = [1,0;0,1];
Dss = [0;0];

[GssNum,GssDen] = ss2tf(Ass,Bss,Css,Dss)
Gdob=[G;G*s]

%controlSystemDesigner(G_exp)
%controlSystemDesigner(G)
[NumG, DenG] = tfdata(G, 'v');
GStates = tf2ss(NumG,DenG)

M1T = 1.5;
A1T = 0.05;
Wb1T = 15;


W1T = tf([1/M1T Wb1T],[1 A1T*Wb1T]);

W1 = [W1T,0;0,0];
%---
W2 = 0.05*tf(1,1);
%---

M3T = 0.02;
A3T = 1;
Wb3T = 2*pi*100;

W3T = tf([1/M3T Wb3T],[1 A3T*Wb3T]);

W3 = [W3T, 0; 0, tf(1e-5)];

augmented = augw(Gdob,W1,W2,W3)
ncont = 1;
nmeas = 2;
[K1, sys_CL,gam1,info] = hinfsyn(augmented,nmeas,ncont);   
K = tf(K1);
% L = K*tfSysLong(2);
% 
% T = L/(1+L);
% S = 1/(1+L);
Sth = minreal(sys_CL(1,1)/W1T);   % referencia theta -> error theta
KSr = minreal(sys_CL(3,1)/W2);    % referencia theta -> control
Tth = minreal(sys_CL(4,1)/W3T);
% step(Tth)
% dcgain(Tth)
figure(1)
subplot(2,2,1), sigma(Sth, 1/W1T), grid on, title('S_\theta vs 1/W_1')
subplot(2,2,2), sigma(KSr, 1/W2),  grid on, title('KS vs 1/W_2')
subplot(2,2,3), sigma(Tth, 1/W3T), grid on, title('T_\theta vs 1/W_3')
subplot(2,2,4), step(Tth),         grid on, title('Escalón \theta')


% Para simulink:
% [NumKH, DenKH] = tfdata(K, 'v') ;
% [NumG6, DenG6] = tfdata(Gdob(2), 'v');

% bandwidth(Tth)
