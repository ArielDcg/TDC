q
1 1 712 307 re W n
[ 711.750025 0 0 -306.75001 1.49981 308.247813 ] concat
/cairo_ascii85_file currentfile /ASCII85Decode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Width 1483
  /Height 640
  /Interpolate false
  /BitsPerComponent 8
  /Decode [ 0 1 0 1 0 1 ]
